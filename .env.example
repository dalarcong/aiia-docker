# PyTorch build for the api image
TORCH_VARIANT=cpu

# Resources for the api container
API_CPUS=4
API_MEMORY=2g

# Host port for the Gradio UI
UI_PORT=7860

# Resources for the train container
TRAIN_CPUS=8
TRAIN_MEMORY=6g

# On a machine with an NVIDIA GPU, uncomment to always use the GPU override:
# COMPOSE_FILE=docker-compose.yaml:docker-compose.gpu.yaml
